model Pengguna {
  id             String   @id @default(uuid())
  email          String   @unique
  nama           String
  kataSandi      String
  role           Role     @default(GUEST)
  dibuatPada     DateTime @default(now())
  diperbaruiPada DateTime @updatedAt

  properti  Properti[]
  pemesanan Pemesanan[]
  ulasan         Ulasan[]
  propertyStaff  PropertyStaff[]
}

enum Role {
  GUEST
  HOST
  ADMIN
}
