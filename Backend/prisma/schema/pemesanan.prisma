model Pemesanan {
  id             String          @id @default(uuid())
  nomorPemesanan String          @unique
  tamuId         String
  propertiId     String
  tipeKamarId    String
  unitKamarId    String?
  paketHargaId   String
  waktuCheckIn   DateTime
  waktuCheckOut  DateTime
  dewasa         Int
  anak           Int             @default(0)
  bayi           Int             @default(0)
  jumlahKamar    Int             @default(1)
  jumlahMalam    Int
  subtotal       Decimal         @db.Decimal(12, 2)
  biayaLayanan   Decimal         @db.Decimal(12, 2)
  pajak          Decimal         @db.Decimal(12, 2)
  diskon         Decimal         @default(0) @db.Decimal(12, 2)
  totalHarga     Decimal         @db.Decimal(12, 2)
  status         StatusPemesanan @default(MENUNGGU_PEMBAYARAN)
  kadaluarsaPada DateTime?
  dibuatPada     DateTime        @default(now())
  diperbaruiPada DateTime        @updatedAt

  tamu       Pengguna   @relation(fields: [tamuId], references: [id], onDelete: Restrict)
  properti   Properti   @relation(fields: [propertiId], references: [id], onDelete: Restrict)
  tipeKamar  TipeKamar  @relation(fields: [tipeKamarId], references: [id], onDelete: Restrict)
  unitKamar  UnitKamar? @relation(fields: [unitKamarId], references: [id], onDelete: SetNull)
  paketHarga PaketHarga @relation(fields: [paketHargaId], references: [id], onDelete: Restrict)

  tamuPemesanan TamuPemesanan[]
  pembayaran    Pembayaran?
  ulasan        Ulasan?
  dataCheckIn   CheckIn?
}

model TamuPemesanan {
  id          String   @id @default(uuid())
  pemesananId String
  nama        String
  email       String?
  telepon     String?
  tipeTamu    TipeTamu @default(DEWASA)

  pemesanan Pemesanan @relation(fields: [pemesananId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id           String   @id @default(uuid())
  pemesananId  String   @unique
  unitKamarId  String
  discanOleh   String?
  waktuCheckIn DateTime @default(now())

  pemesanan Pemesanan @relation(fields: [pemesananId], references: [id], onDelete: Cascade)
  unitKamar UnitKamar @relation(fields: [unitKamarId], references: [id], onDelete: Cascade)
}

enum StatusPemesanan {
  MENUNGGU_PEMBAYARAN
  PEMBAYARAN
  DIKONFIRMASI
  CHECK_IN
  SELESAI
  DIBATALKAN
  KADALUARSA
  DIKEMBALIKAN
}

enum TipeTamu {
  DEWASA
  ANAK
  BAYI
}
